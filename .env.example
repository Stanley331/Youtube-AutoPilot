# Copy this file to .env and fill in the keys you have.
# LLM_PROVIDER: gemini (default), anthropic, or nemotron
# Gemini free-tier prompts and responses may be used to improve Google products; do not send sensitive data.
# Kokoro runs locally by default; ElevenLabs is optional.
# PIXABAY_API_KEY is needed for the default pixabay visuals; choose visuals.source: illustration to skip it.

LLM_PROVIDER=gemini
# Provider for ten-minute scripts only (long and doodle videos): gemini, anthropic, or nemotron.
# Empty = Gemini whenever GEMINI_API_KEY is set (small free models write thin, vague chapters),
# otherwise LLM_PROVIDER.
LONG_SCRIPT_PROVIDER=
# Provider for prompts that include images (ranking stock candidates). Defaults to gemini when
# GEMINI_API_KEY is set, otherwise LLM_PROVIDER. Nemotron needs a vision-capable model for this.
VISION_PROVIDER=
# --- Gemini ---
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# Gemini TTS (voice.engine: gemini) uses the same key; override the models here if Google renames them.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-lite-tts
GEMINI_API_KEY=
# --- Anthropic ---
ANTHROPIC_API_KEY=
# --- Nemotron (NVIDIA) ---
# Get a free API key at build.nvidia.com. Nemotron 3.5 Super VL can generate text scripts.
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-bolt-e4b
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# --- Pixabay ---
PIXABAY_API_KEY=
# --- Kaggle (doodle videos draw their images on Kaggle's free GPUs) ---
# kaggle.com/settings -> API -> Generate New Token. Verify your phone on Kaggle so notebooks get a GPU and internet.
KAGGLE_API_TOKEN=
# Only for a legacy kaggle.json key (or if the username cannot be read from the token):
# KAGGLE_USERNAME=
# KAGGLE_KEY=
